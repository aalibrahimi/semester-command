# Copy to .env and fill in. .env is gitignored; never commit real values.
# Railway Postgres, public proxy URL (Railway: Postgres service > Variables > DATABASE_PUBLIC_URL).
# Used by `bun run db:status | db:push | db:pull` (scripts/railway-sync.ts).
DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway"
